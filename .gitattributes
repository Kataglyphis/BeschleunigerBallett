# A CR makes bash fail with "$'\r': command not found", whatever core.autocrlf says.
*.sh    text eol=lf
*.bash  text eol=lf

# appimagetool rejects a .desktop entry containing any CR.
*.desktop text eol=lf

# Windows-only scripts stay CRLF-friendly; they never run under bash.
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Vendored hub config stays LF: Sync-SharedConfig normalises line endings, so a CRLF copy drifts unnoticed.
.clang-format text eol=lf
.clang-tidy text eol=lf
.cmake-format.yaml text eol=lf
.pre-commit-config.yaml text eol=lf
gcovr.cfg text eol=lf

# exclude all files from language analysis which do not directly contribute to engine
third_party/** linguist-vendored
Documents/** linguist-vendored
build/** linguist-vendored

# The font license texts are pinned by SHA-256 in licenses/imgui-fonts.NOTICE.
licenses/fonts/** -text
# Bash reads the mapping line by line; a CR would end up in every source path.
licenses/third-party-licenses.txt text eol=lf
# The Sponza text is checked against its recorded SHA-256.
licenses/CC-BY-3.0.txt -text
