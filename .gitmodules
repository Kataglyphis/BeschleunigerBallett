[submodule "third_party/SPDLOG"]
	path = third_party/SPDLOG
	url = https://github.com/gabime/spdlog
	branch = v1.x
# third_party/FUZZTEST deliberately carries NO `branch =` entry, unlike every
# other submodule here. There is no correct value for it. The pin 704efb34 is
# the exact tip of google/fuzztest's dated release branch release_2026-06-29
# (and the tag 2026-06-29); it is NOT on main - GitHub's compare of
# main...704efb34 reports ahead 1, behind 81. So `branch = main` would track a
# line this pin was never taken from, while `branch = release_2026-06-29`
# names a frozen branch that can never produce a bump: an entry that looks
# watched while covering nothing, which is the one failure mode this repo's
# gates exist to prevent. Upstream cuts a NEW release_<date> branch each time.
# CORRECTED 2026-09-09 - the paragraph that used to stand here was wrong.
# Leaving `branch` unset does NOT keep `git submodule update --remote` disarmed
# for this path. An unset branch makes --remote fall back to the REMOTE'S
# DEFAULT BRANCH, so a bare --remote in this repo walks FUZZTEST from 704efb34
# onto main: 82 commits down the very line this pin was never taken from.
# Established by experiment, not by reading: a synthetic superproject whose
# submodule declares no branch and whose remote default is named `trunk` had
# `trunk` checked out by --remote, so the fallback really is remote HEAD and not
# a hardcoded main/master.
# This also removes the premise of the 2026-07-20 investigation into this
# submodule's unexplained re-checkouts, recorded in the header of
# third_party/ContainerHub/shared/windows/tests/Submodule.Pins.Tests.ps1: that
# investigation ruled --remote out BECAUSE the branch is unset, and that is not
# a reason. --remote belongs back on the list of candidates.
# Keep `branch` unset regardless - the argument above about main versus a frozen
# release_<date> branch is unaffected - but never run a bare
# `git submodule update --remote` in this repo. Pass explicit paths. The
# git-submodules manager is held to dashboard-approval for this path in
# .github/renovate.json.
[submodule "third_party/FUZZTEST"]
	path = third_party/FUZZTEST
	url = https://github.com/google/fuzztest
[submodule "third_party/KOMPUTE"]
	path = third_party/KOMPUTE
	url = https://github.com/KomputeProject/kompute.git
	branch = master
[submodule "third_party/ContainerHub"]
	path = third_party/ContainerHub
	url = git@github.com:Kataglyphis/ContainerHub.git
	branch = main
[submodule "third_party/OxidANT"]
	path = third_party/OxidANT
	url = git@github.com:Kataglyphis/OxidANT.git
	branch = develop
