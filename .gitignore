cmake_test_discovery_*.json

# Blender autosave twins of tracked .blend files
*.blend1

# Dear ImGui layout: per-user state, rewritten whenever a window is dragged.
imgui.ini

# CTest run output; ignored so the tracked-and-ignored guard can catch a tracked copy.
Testing/

# Large-asset gate: see AGENTS.md § Large tracked assets. Tracked files are listed back with `!`.

# DCC project files: nothing in this tree reads them.
*.blend
!Resources/Models/Sulo/New_0.9.blend
*.fbx
*.max
*.ma
*.mb
*.c4d
*.3ds
*.ztl
*.spp
*.psd
*.xcf

# Archives and disk images: a committed blob is a packaging step nobody can re-run.
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz
*.iso

# Video belongs in a release asset, not in every clone.
*.mp4
*.mov
*.avi
*.mkv
*.webm

# Scoped to Resources/: the vendored third_party/KTX corpus tracks its own .exr/.hdr/.dds/.tga.
Resources/**/*.tif
Resources/**/*.tiff
Resources/**/*.exr
Resources/**/*.hdr
Resources/**/*.tga
Resources/**/*.dds
!Resources/Models/Sulo/WolfStahl/textures/MetalSpottyDiscoloration001_DISP16_4K_METALNESS.tif

# Wavefront meshes: the tracked ones are listed back so a new one has to be typed, not swept in.
