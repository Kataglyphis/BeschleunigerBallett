[
  {
    "id": "sponza.project-wires-install",
    "target": "CMakeLists.txt",
    "find": "include(cmake/SponzaLicenses.cmake)",
    "replace": "set(SPONZA_INSTALL_REMOVED TRUE)",
    "test": "bash scripts/linux/tests/test-sponza-package-license.sh",
    "why": "The actual project must invoke the scene license install rules."
  },
  {
    "id": "sponza.install-license",
    "target": "cmake/SponzaLicenses.cmake",
    "find": "FILES \"${CMAKE_CURRENT_LIST_DIR}/../licenses/CC-BY-3.0.txt\"",
    "replace": "FILES",
    "test": "bash scripts/linux/tests/test-sponza-package-license.sh",
    "why": "The actual CMake package must contain the complete scene license."
  },
  {
    "id": "sponza.deb-license-check",
    "target": "scripts/linux/check-deb-layout.sh",
    "find": "  --require \"usr/Resources/Models/crytek-sponza/CC-BY-3.0.txt=${repo_root}/licenses/CC-BY-3.0.txt\" \\",
    "replace": "",
    "test": "bash scripts/linux/tests/test-check-deb-layout.sh",
    "why": "The DEB gate must reject a missing or changed scene license."
  },
  {
    "id": "sponza.deb-notice-check",
    "target": "scripts/linux/check-deb-layout.sh",
    "find": "  --require \"usr/Resources/Models/crytek-sponza/crytek-sponza.NOTICE=${repo_root}/licenses/crytek-sponza.NOTICE\"; then",
    "replace": "  ; then",
    "test": "bash scripts/linux/tests/test-check-deb-layout.sh",
    "why": "The DEB gate must reject a missing scene provenance notice."
  },
  {
    "id": "msix.project-license",
    "target": "scripts/windows/Build-Windows.ps1",
    "find": "    'share/licenses/GraphicsEngine/LICENSE' = 'LICENSE'",
    "replace": "    # removed for mutation proof",
    "test": "pwsh -NoProfile -File scripts/linux/tests/test-msix-license.ps1",
    "why": "A built MSIX must retain the full project license."
  },
  {
    "id": "msix.sponza-license",
    "target": "scripts/windows/Build-Windows.ps1",
    "find": "    'Resources/Models/crytek-sponza/CC-BY-3.0.txt' = 'licenses/CC-BY-3.0.txt'",
    "replace": "    # removed for mutation proof",
    "test": "pwsh -NoProfile -File scripts/linux/tests/test-msix-license.ps1",
    "why": "A built MSIX must retain the full Sponza license."
  },
  {
    "id": "msix.sponza-notice",
    "target": "scripts/windows/Build-Windows.ps1",
    "find": "    'Resources/Models/crytek-sponza/crytek-sponza.NOTICE' = 'licenses/crytek-sponza.NOTICE'",
    "replace": "    # removed for mutation proof",
    "test": "pwsh -NoProfile -File scripts/linux/tests/test-msix-license.ps1",
    "why": "A built MSIX must retain the Sponza source notice."
  },
  {
    "id": "msix.verify-artifact",
    "target": "scripts/windows/Build-Windows.ps1",
    "find": "      Assert-MsixLicenseContents -Path $msixOutPath -WorkspacePath $workspacePath",
    "replace": "      Write-Output 'removed'",
    "test": "pwsh -NoProfile -File scripts/linux/tests/test-msix-license.ps1",
    "why": "The completed MSIX must be checked before the build can pass."
  },
  {
    "id": "msix.failure-fatal",
    "target": "scripts/windows/Build-Windows.ps1",
    "find": "    Invoke-BuildStep -Context $context -StepName 'MSIX packaging' -Critical -Script {",
    "replace": "    Invoke-BuildOptional -Context $context -Name 'MSIX packaging' -Script {",
    "test": "pwsh -NoProfile -File scripts/linux/tests/test-msix-license.ps1",
    "why": "A selected MSIX packaging failure must not be advisory."
  }
]
